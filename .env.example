# cp .env.example .env
# service ไม่มี login: ใครเข้าถึง port ได้ก็สั่งงานได้ → คง RUNNER_HOST=127.0.0.1 ไว้ (อย่าตั้งเป็น 0.0.0.0 บนเครือข่ายที่ไม่ไว้ใจ)
# สำเนา drone-sitl ใน repo นี้ (vendor/README.md) · ชี้ checkout drone-sitl อื่นได้ด้วย path เต็ม
DRONE_SITL_DIR=vendor/drone-sitl
# ของที่ติดตั้งไว้ที่อื่นที่ไม่ใช่ค่า default ของ launch-sitl.sh (scripts/preflight.sh ตรวจให้)
#ISAAC_DIR=$HOME/isaac-sim6
#PEGASUS_EXTS=$HOME/PegasusSimulator/extensions
#CONDA_ENV=drone
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8095
#RUNS_DIR=/home/innovation/pai/flight-service/data/runs
#ALLOWED_IMAGES=<regex คั่นด้วยช่องว่าง>
#MAX_PENDING=1
#DATA_RETENTION_GB=10
#KEEP_IMAGE=0
# สเปกโดรน: ใช้กับทุกงาน · ค่าเป็น Python literal · แก้แล้วต้อง restart service (README หัวข้อ "สเปกโดรน")
# ค่าที่ไม่ได้อยู่ในนี้ (เลนส์กล้อง, takeoff, ความเร็วสูงสุด, ฟิสิกส์, airframe PX4) ต้องทำ vendor patch
#DRONE_SETUP_ADD_WIND=False          # ลม: เปิดแล้ว default 5 m/s กระโชก ±50% ทิศสุ่มทุกรอบ
#DRONE_SETUP_WIND_SPEED_MS=5.0
#DRONE_SETUP_WIND_FROM_DEG=None      # ทิศที่ลมพัดมา (270 = จากทิศตะวันตก) · None = สุ่ม
#DRONE_SETUP_WIND_GUST_FRAC=0.5
#DRONE_SETUP_WIND_SEED=None          # ใส่เลขเพื่อให้ลมเหมือนกันทุกรอบ (ยุติธรรมระหว่างทีม)
#SPAWN_XYZ='[4.7762, -19.3996, 6.4826]'   # จุดขึ้นบิน (z สัมบูรณ์) · default จาก sim/sites.py
#HEADING_DEG=0.0
#DRONE_SETUP_REC_W=1280              # ความละเอียด/เฟรมเรตของคลิปที่อัด (detections.mp4)
#DRONE_SETUP_REC_H=800
#DRONE_SETUP_REC_FPS=30
#DRONE_SETUP_DOWN_Z_OFFSET=-0.05     # กล้องล่างต่ำกว่าตัวโดรน (m)
#DRONE_SETUP_DOWN_VIB_DAMP=True      # ยางกันสั่นของกล้องล่าง
